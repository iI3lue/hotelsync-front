# URLs base de cada microservicio (con /v1 al final).
# En Vercel se setean como Environment Variables ANTES del build
# (las NEXT_PUBLIC_* se inyectan en tiempo de compilacion).
# En local, copiar a .env.local apuntando a los servicios dev.
NEXT_PUBLIC_PROPERTY_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_RATE_API_URL=http://localhost:3002/v1
NEXT_PUBLIC_USER_API_URL=http://localhost:3003/v1
NEXT_PUBLIC_BOOKING_API_URL=http://localhost:3004/v1
NEXT_PUBLIC_FRONT_DESK_API_URL=http://localhost:3005/v1
NEXT_PUBLIC_HOUSEKEEPING_API_URL=http://localhost:3006/v1
NEXT_PUBLIC_BILLING_API_URL=http://localhost:3007/v1
NEXT_PUBLIC_LOYALTY_API_URL=http://localhost:3009/v1
NEXT_PUBLIC_PAYMENT_API_URL=http://localhost:3010/v1
NEXT_PUBLIC_ANALYTICS_API_URL=http://localhost:3011/v1
# Solo servidor (BFF): channel-manager no se expone con NEXT_PUBLIC_.
CHANNEL_MANAGER_API_URL=http://localhost:3008/v1
# Provider-key del canal simulado; la usa solo /api/simulator/reservations.
CHANNEL_MANAGER_SIMULATOR_KEY=
# Base publica del front (callbacks y logout de Auth0).
# En Vercel: https://hotelsync-front.vercel.app
APP_BASE_URL=http://localhost:3000
# Auth0 (login con Google). Nunca commitear valores reales.
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_CLIENT_ID=tu-client-id
AUTH0_CLIENT_SECRET=tu-client-secret
