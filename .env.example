# URLs base de cada microservicio (con /v1 al final).
# En Vercel se setean como Environment Variables ANTES del build
# (las NEXT_PUBLIC_* se inyectan en tiempo de compilacion).
# En local, copiar a .env.local apuntando a los servicios dev.
NEXT_PUBLIC_PROPERTY_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_RATE_API_URL=http://localhost:3002/v1
NEXT_PUBLIC_BOOKING_API_URL=http://localhost:3004/v1
NEXT_PUBLIC_FRONT_DESK_API_URL=http://localhost:3005/v1
NEXT_PUBLIC_HOUSEKEEPING_API_URL=http://localhost:3006/v1
NEXT_PUBLIC_BILLING_API_URL=http://localhost:3007/v1
